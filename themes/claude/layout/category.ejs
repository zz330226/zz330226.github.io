<!-- 分类页面 - 左右布局 -->
<div class="post-page-wrapper">
  <!-- 左侧：文章列表 -->
  <div class="post-main">
    <div class="post-header">
      <h1 class="post-title"><i class="fas fa-folder-open"></i> 分类：<%= page.category %></h1>
      <div class="post-meta">
        <span><i class="fas fa-file-alt"></i> 共 <%= page.posts.length %> 篇文章</span>
      </div>
    </div>

    <div class="articles-list">
      <% page.posts.sort('-date').each(function(post) { %>
        <article class="article-card">
          <div class="article-thumbnail">
            <a href="<%= url_for(post.path) %>">
              <div class="default-thumbnail">
                <i class="fas fa-file-alt"></i>
              </div>
            </a>
          </div>
          <div class="article-info">
            <h2 class="article-title">
              <a href="<%= url_for(post.path) %>"><%= post.title %></a>
            </h2>
            <div class="article-meta">
              <span><i class="fas fa-clock"></i> <%= date(post.date, 'YYYY-MM-DD') %></span>
              <% if (post.categories && post.categories.length) { %>
                <span class="meta-category"><i class="fas fa-folder"></i> <%= post.categories.toArray()[0].name %></span>
              <% } %>
            </div>
            <% if (post.description || post.excerpt) { %>
              <p class="article-desc"><%= (post.description || post.excerpt).replace(/<[^>]+>/g, '').substring(0, 100) %>...</p>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  </div>

  <!-- 右侧：侧边栏 -->
  <aside class="post-sidebar">
    <!-- 搜索框 -->
    <div class="sidebar-widget search-widget">
      <div class="widget-title"><i class="fas fa-search"></i> 搜索</div>
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="搜索文章...">
        <button id="searchBtn"><i class="fas fa-search"></i></button>
      </div>
    </div>

    <!-- 最新文章 -->
    <div class="sidebar-widget">
      <div class="widget-title"><i class="fas fa-newspaper"></i> 最新文章</div>
      <ul class="widget-list">
        <% site.posts.sort('-date').limit(6).forEach(function(post) { %>
          <li><a href="<%= url_for(post.path) %>"><%= post.title %></a></li>
        <% }); %>
      </ul>
    </div>

    <!-- 标签云 3D -->
    <div class="sidebar-widget tag-cloud-widget">
      <div class="widget-title"><i class="fas fa-tags"></i> 标签云</div>
      <div class="tag-cloud-3d" id="tagCloud3d">
        <% var tagsArray = site.tags.toArray(); %>
        <% tagsArray.forEach(function(tag, index) { %>
          <a href="<%= url_for(tag.path) %>" class="tag-3d-item" data-index="<%= index %>"><%= tag.name %></a>
        <% }); %>
      </div>
    </div>
  </aside>
</div>
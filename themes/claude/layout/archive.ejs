<div class="archive-page">
  <h1 class="archive-title"><i class="fas fa-archive"></i> 归档</h1>
  <div class="archive-list">
    <% var years = {}; %>
    <% site.posts.sort('-date').each(function(post) { %>
      <% var year = date(post.date, 'YYYY'); %>
      <% if (!years[year]) years[year] = []; %>
      <% years[year].push(post); %>
    <% }); %>
    <% Object.keys(years).sort().reverse().forEach(function(year) { %>
      <div class="archive-year">
        <h2 class="year-title"><%= year %></h2>
        <% years[year].forEach(function(post) { %>
          <div class="archive-item">
            <span class="archive-date"><%= date(post.date, 'MM-DD') %></span>
            <a class="archive-title-link" href="<%= url_for(post.path) %>"><%= post.title %></a>
          </div>
        <% }); %>
      </div>
    <% }); %>
  </div>
</div>